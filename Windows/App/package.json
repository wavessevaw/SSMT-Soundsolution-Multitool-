{
  "name": "ssmt",
  "productName": "SSMT",
  "version": "1.5.0",
  "description": "SSMT FOH Assist for Windows",
  "author": "Sound Solutions",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/engine-smoke.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.soundsolutions.ssmt",
    "productName": "SSMT",
    "copyright": "Sound Solutions",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "engine", "to": "engine" }],
    "win": { "target": ["nsis"], "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SSMT",
      "artifactName": "SSMT-Setup-${version}.exe"
    }
  }
}
