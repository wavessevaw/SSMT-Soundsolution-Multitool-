{
  "name": "ssmt",
  "productName": "SSMT",
  "version": "1.5.1",
  "description": "SSMT FOH Assist for Windows",
  "author": "Sound Solutions",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke": "node scripts/engine-smoke.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "lucide-static": "^1.52.0",
    "playwright-core": "^1.50.1"
  },
  "build": {
    "appId": "com.soundsolutions.ssmt",
    "productName": "SSMT",
    "copyright": "Sound Solutions",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SSMT",
      "artifactName": "SSMT-Setup-${version}.exe"
    }
  }
}
