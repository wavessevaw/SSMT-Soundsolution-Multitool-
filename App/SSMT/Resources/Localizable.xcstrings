    "show.group.multitrackHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One track per cue. Drag a clip to move its start (pre-wait), its edges to trim, ⌥-drag to slip the sound inside it; ⌥← / ⌥→ nudge by 0.1 s. Clips snap to each other and to the yellow playback line (⌘ while dragging: no snapping); click the ruler to play from there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая кью — своя дорожка. Перетащите клип — сдвиг старта (паузы до), края — обрезка, с ⌥ — сдвиг звука внутри клипа; ⌥← / ⌥→ — на 0,1 с. Клипы прилипают друг к другу и к жёлтой линии воспроизведения (⌘ — без прилипания); щелчок по линейке — играть оттуда."
          }
        }
      }
    },
