    "assist.connect.after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real console is read-only in this version: the assistant records your work for learning and changes nothing. Soundcheck, show guard and console test are coming soon; in the simulator they all work. The lamp in the header is green while the console answers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии настоящий пульт подключается только на чтение: ассистент записывает вашу работу для обучения и ничего не меняет. Саундчек, страховка шоу и тест пульта скоро будут доступны; в симуляторе всё работает. Лампочка в шапке горит зелёным, пока пульт отвечает."
          }
        }
      }
    },
