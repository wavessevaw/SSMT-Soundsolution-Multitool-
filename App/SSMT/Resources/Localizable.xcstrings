      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac and the console are on the same router (Wi-Fi or cable). Levels and the console RTA come over the network; the measurement mic is plugged into the Mac's audio interface."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac и пульт в одной сети роутера (Wi-Fi или кабель). Уровни и RTA пульта приходят по сети; измерительный микрофон подключён к звуковой карте Mac."
          }
        }
      }
    },
