    "assist.test.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to a real console, the channels play a made-up show: the assistant names them, sets levels, tunes every parameter, checks polarity and guards a monitor loop — all on the console — and reads every value back. In the simulator it runs against a built-in X32 emulator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На подключённом настоящем пульте каналы разыгрывают выдуманное шоу: ассистент даёт им названия, выставляет уровни, настраивает все параметры, проверяет полярность и страхует петлю в мониторе — всё на пульте — и читает каждое значение обратно. В симуляторе тест идёт на встроенном эмуляторе X32."
          }
        }
      }
    },
