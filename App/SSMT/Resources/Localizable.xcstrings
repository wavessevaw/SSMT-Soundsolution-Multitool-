    "assist.learn.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the recording before the event and stop it after. Once a second every console parameter is recorded: faders, gain, channel and bus EQ, gate and compressor with gain reduction, sends, DCAs, effects, levels and the RTA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите запись перед началом мероприятия и остановите после него. Раз в секунду записываются все параметры пульта: фейдеры, гейн, эквалайзеры каналов и шин, гейт и компрессор с подавлением, посылы, DCA, эффекты, уровни и RTA."
          }
        }
      }
    },
