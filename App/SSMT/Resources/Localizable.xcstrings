    "assist.groupHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orchestra and Choir find the channels by their names on the console (Violin, Vc, Скрипка, Choir, Хор…). All of them are tuned at once at a low level, balanced, then brought up while the measurement mic listens for feedback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оркестр» и «Хор» находят каналы по названиям на пульте (Violin, Vc, Скрипка, Choir, Хор…). Все каналы настраиваются одновременно на небольшой громкости, балансируются и поднимаются, пока измерительный микрофон контролирует возникновение обратной связи."
          }
        }
      }
    },
    "assist.guard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show guard"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страховка шоу"
          }
        }
      }
    },
    "assist.guard.active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarding · %ld corrections"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страхую · поправок: %ld"
          }
        }
      }
    },
    "assist.guard.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to correct yet."
          }
        },
        "ru": {
          "stringUnit": {
