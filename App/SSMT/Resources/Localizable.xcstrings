    "assist.sim.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A made-up show plays on the console: musicians come and go by scene and a virtual engineer rides the faders (motor faders move on a real X32). The guard backs him up as in a real show."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На пульте разыгрывается выдуманное шоу: музыканты вступают и уходят по сценам, виртуальный звукорежиссёр двигает фейдеры (на настоящем X32 едут моторные фейдеры). Страховка работает как на настоящем шоу."
          }
        }
      }
    },
