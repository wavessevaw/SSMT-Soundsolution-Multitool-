          }
        }
      }
    },
    "assist.guard.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mix. The assistant never moves channel faders: it notches hall feedback, pulls a ringing monitor down a step and brings it back, keeps the lead clear in mass scenes and holds tonal drift — a few dB at most, all undone when not needed. Anything you touch, it leaves alone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микс ведёт звукорежиссёр. Ассистент не изменяет фейдеры каналов: подавляет акустическую обратную связь в зале, временно снижает уровень мониторной линии при самовозбуждении и восстанавливает его, сохраняет разборчивость солиста в массовых сценах и компенсирует эффект близости — в пределах нескольких дБ; все коррекции снимаются, когда в них нет необходимости. Параметры, изменённые звукорежиссёром, ассистент не трогает."
          }
        }
      }
    },
    "assist.guard.leads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep intelligible (leads)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать разборчивыми (солисты)"
          }
        }
