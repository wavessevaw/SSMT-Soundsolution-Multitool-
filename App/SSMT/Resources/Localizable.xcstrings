    "acc.levelsText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new level comes when the XP is reached AND both minimums are met: hours and clicks. XP for measurements, shows and achievements speeds things up for those who really work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый уровень — когда набран опыт И выполнены оба минимума: часы и клики. Опыт за измерения, шоу и ачивки ускоряет рост для тех, кто реально работает."
          }
        }
      }
    },
