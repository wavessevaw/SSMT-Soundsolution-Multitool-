      }
    },
    "assist.soon.text.show": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The show guard (automatic protection against feedback and overload during the show) is unavailable on a real console for now. It returns after learning from your events. The show simulation works in the simulator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страховка (автоматическая защита от обратной связи и перегрузок во время шоу) на настоящем пульте пока недоступна. Она вернётся после обучения на ваших мероприятиях. Симуляция шоу работает в симуляторе."
          }
        }
      }
    },
    "assist.soon.text.soundcheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the field test, automatic channel tuning on a real console is off. It works in the simulator. To teach the assistant, record your events on the Learning tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После полевого теста автоматическая настройка каналов на настоящем пульте отключена. Она работает в симуляторе. Чтобы ассистент научился, записывайте свои мероприятия во вкладке «Обучение»."
          }
        }
      }
    },
    "assist.soon.text.test": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The console test changes parameters on the console, so it is off on a real console in this version. The link diagnostics are on the Learning tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест пульта меняет параметры на пульте, поэтому на настоящем пульте в этой версии он отключён. Диагностика связи — во вкладке «Обучение»."
          }
        }
      }
    },
